#!/usr/bin/env bash
#
# Refuse a commit that carries a hand-edited generated file.
#
# This replaces the `PostToolUse` mirror hook, which tried to *recover* such an
# edit by turning it into a revision. It had three moving parts and two of them
# did not work: it called `keel mirror`, a command that does not exist, and
# swallowed the failure with `|| true`; and it read `SPECLINE_SESSION_ID`, which
# nothing anywhere sets. So every edit it claimed to capture was silently lost,
# and the guarantee written into it and into the plugin README — "the database
# wins unconditionally afterwards, the file is regenerated" — was false.
#
# A mechanism that silently does not work is worse than no mechanism, because
# it is *relied upon*. This one fails loudly and does nothing else: it does not
# write to the store, does not rewrite your files, and does not try to guess
# what you meant. It tells you the edit will be reverted and where to make it
# instead.
#
# Install:  ln -sf ../../scripts/pre-commit .git/hooks/pre-commit
# Bypass:   git commit --no-verify   (for the one case below)

set -uo pipefail

# The project whose files this repository generates. `specline generate --check`
# needs to know which project's outputs to compare against.
project="${SPECLINE_PROJECT:-specline}"

# Nothing staged under a generated file means nothing to check. Committing a
# code change should not pay for a store round-trip.
#
# **Only two generated files are tracked**, since `product/` and `.specline/`
# stopped being published: the standing contract at `.claude/CONTRACT.md`, which
# has to survive a clone because the root `CLAUDE.md` imports it, and
# `.specline/glossary.md`. Everything else generates into an ignored directory,
# where a hand edit costs nothing because git never sees it.
#
# This glob said `.keel/**/*.md` until 2026-09-10 — the pre-rename directory
# name — so for as long as the rename had been in, the hook checked nothing
# under `.specline/` and exited 0 saying there was nothing to check. That is the
# failure this hook exists to prevent, wearing the hook's own clothes.
staged="$(git diff --cached --name-only --diff-filter=ACM -- '.claude/CONTRACT.md' '.specline/glossary.md' 2>/dev/null)"
[ -n "$staged" ] || exit 0

# The **newest** usable build wins, and PATH loses ties.
#
# Not a fixed order, which is what this did first and which was wrong in both
# directions. This machine had a `keel` from an earlier day on PATH — one with a
# `mirror` subcommand and no `generate` — which is also why the hook this
# replaces called `keel mirror`: the command existed when it was written and was
# renamed underneath it. Preferring the repository's own build fixed that, and
# then broke the same way from the other side: `target/release/specline` was checked
# first while being eighty minutes older than `target/debug/specline`, so a commit
# adding a renderer was told all 42 of its outputs were stale.
#
# A check that runs the wrong binary reports drift that is not there, and a
# check that cries wolf gets bypassed with --no-verify, which is the same
# disease as a hook that silently does nothing. Age is the honest tiebreak: the
# most recently built binary is the one that knows about the change being
# committed.
specline_bin=""
newest=0
for candidate in target/release/specline target/debug/specline "$(command -v specline 2>/dev/null || true)"; do
  [ -n "$candidate" ] && [ -x "$candidate" ] || continue
  "$candidate" generate --help >/dev/null 2>&1 || continue
  # `stat -c %Y` on GNU, `stat -f %m` on BSD/macOS — **in that order**, and the
  # order is the whole of it.
  #
  # BSD-first looks symmetrical and is not, because the two failures are not
  # alike. BSD `stat -c` is an illegal option and exits non-zero, so the
  # fallback fires. GNU `stat -f` is `--file-system` and `%m` is the *mount
  # point*: it prints `/` and exits **0**, so the fallback never runs, `mtime`
  # is a path, and `[ "/" -ge 0 ]` is an error. The loop then finds no usable
  # binary and the hook exits 0 saying generated files were not checked.
  #
  # So on every Linux machine this hook has been quietly doing nothing — which
  # is the exact failure the `PostToolUse` hook was deleted for, in the file
  # written to replace it. Found by the tests in `crates/specline/tests/hooks.rs`
  # the first time CI ran them on Linux.
  #
  # The `case` is belt and braces: anything that is not a plain number counts
  # as age zero rather than crashing the comparison. A usable binary beats none.
  mtime="$(stat -c %Y "$candidate" 2>/dev/null || stat -f %m "$candidate" 2>/dev/null || echo 0)"
  case "$mtime" in
  '' | *[!0-9]*) mtime=0 ;;
  esac
  if [ "$mtime" -ge "$newest" ]; then
    newest="$mtime"
    specline_bin="$candidate"
  fi
done

# A missing or unusable binary must not block a commit — that would make the
# check worse than the hook it replaces. Say so and get out of the way.
if [ -z "$specline_bin" ]; then
  echo "pre-commit: no specline build understands \`generate\`, so generated files were not checked." >&2
  exit 0
fi

# The tree the commit is in, which is not always the tree Specline has on file.
#
# Without `--repo`, `generate --check` resolves the project's recorded
# `root_path` — the main checkout. From a git worktree that is somebody else's
# copy of the files, and the check is wrong in both directions: it reports drift
# for a worktree that regenerated clean, and — the half that matters — it
# compares a genuinely hand-edited file against the main checkout's copy, so if
# that copy is current the edit is waved through. That is the failure this hook
# exists to replace, arriving through the hook itself.
#
# `--show-toplevel` is the worktree's own root, and equals `root_path` when
# there is no worktree, so this is not a special case for one.
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")"

drift="$("$specline_bin" generate "$project" --repo "$repo_root" --check 2>&1)"
status=$?
[ $status -eq 0 ] && exit 0

# "The check could not run" is not "the files are wrong", and reporting one as
# the other is how a green check comes to mean nothing.
case "$drift" in
  *"Conflicting lock"*|*"Unknown error code"*)
    echo "pre-commit: could not read the store (the daemon holds it). Generated files were not checked." >&2
    exit 0
    ;;
esac

cat >&2 <<EOF

  A generated file does not match what Specline would produce.

$drift

  Every file under product/ is an output. An edit here is not wrong so much as
  futile: the next \`specline generate\` overwrites it from the store, and the
  reasoning in it is gone.

  Make the change where it lives:

    • prose      — ask Claude to write it, or edit it in the app
    • the tracker— change the task rows; product/STATUS.md is rendered from them
    • then       — specline generate $project --repo "$repo_root"

  If you are deliberately committing a divergence, use --no-verify.

EOF
exit 1
